{
  "private": true,
  "name": "vue-repl",
  "version": "0.0.0",
  "description": "My awesome typescript library",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build --scope=vue-repl --scope=vite-plugin-*"
  },
  "turbo": {
    "baseBranch": "origin/main",
    "npmClient": "pnpm",
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "dist/**"
        ]
      },
      "test": {
        "cache": false
      },
      "dev": {
        "cache": false
      }
    }
  },
  "devDependencies": {
    "@egoist/prettier-config": "1.0.0",
    "prettier": "2.5.1",
    "turbo": "^1.0.19",
    "typescript": "4.5.4",
    "vite": "^2.7.3",
    "vitest": "^0.0.97"
  }
}
