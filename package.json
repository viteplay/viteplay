{
  "private": true,
  "name": "@viteplay/monorepo",
  "version": "0.0.2",
  "description": "My awesome typescript library",
  "license": "MIT",
  "packageManager": "pnpm@6.28.0",
  "scripts": {
    "build": "nx run-many --target=build --parallel --all",
    "dev": "node scripts/dev.js",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "nx run-many --target=test --parallel --all",
    "lint": "nx run-many --target=lint --parallel --all"
  },
  "devDependencies": {
    "@nrwl/cli": "latest",
    "@nrwl/nx-cloud": "latest",
    "@nrwl/tao": "latest",
    "@nrwl/workspace": "latest",
    "@types/node": "17.0.7",
    "bumpp": "^7.1.1",
    "prettier": "2.5.1",
    "tsup": "^5.11.12",
    "typescript": "4.5.4",
    "vitest": "0.2.1"
  }
}
