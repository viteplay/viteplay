{
  "private": true,
  "name": "@viteplay/monorepo",
  "version": "0.0.0",
  "description": "My awesome typescript library",
  "license": "MIT",
  "packageManager": "pnpm@6.28.0",
  "scripts": {
    "build": "turbo run build --scope=\"@viteplay/*\" --no-deps",
    "dev": "node scripts/dev.js",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag --preid alpha && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@types/node": "17.0.7",
    "bumpp": "^7.1.1",
    "prettier": "2.5.1",
    "turbo": "^1.1.0",
    "typescript": "4.5.4",
    "vitest": "0.2.1"
  }
}
