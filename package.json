{
  "private": true,
  "name": "@viteplay/monorepo",
  "version": "0.2.1",
  "description": "Automated Component Development Environment",
  "license": "MIT",
  "packageManager": "pnpm@6.28.0",
  "scripts": {
    "typecheck": "turbo run typecheck --scope=@viteplay/vue --no-deps",
    "build": "turbo run build --scope=@viteplay/vue --scope=@viteplay/plugin --no-deps",
    "dev": "node scripts/dev.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "turbo run test",
    "lint": "turbo run lint --parallel"
  },
  "devDependencies": {
    "@types/node": "17.0.7",
    "bumpp": "^7.1.1",
    "prettier": "2.5.1",
    "tsup": "^6.0.1",
    "turbo": "^1.2.9",
    "typescript": "^4.6.4",
    "vitepress": "^1.0.0-alpha.9",
    "vitest": "0.22.1",
    "vue": "^3.2.37"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "react",
        "react-dom",
        "@types/react"
      ]
    }
  }
}
