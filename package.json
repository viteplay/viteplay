{
  "private": true,
  "name": "@viteplay/monorepo",
  "version": "0.2.9",
  "description": "Automated Component Development Environment",
  "license": "MIT",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "typecheck": "turbo run typecheck --scope=@viteplay/vue --scope=@viteplay/plugin --no-deps",
    "build": "turbo run build --scope=@viteplay/vue --scope=@viteplay/plugin --no-deps",
    "dev": "node scripts/dev.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "turbo run test",
    "lint": "turbo run lint --parallel"
  },
  "devDependencies": {
    "@types/node": "16.18.32",
    "bumpp": "^9.1.0",
    "prettier": "2.8.8",
    "tsup": "^6.7.0",
    "turbo": "^1.9.9",
    "typescript": "^5.0.4",
    "vitepress": "1.0.0-beta.1",
    "vitest": "0.31.1",
    "vue": "^3.3.4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "react",
        "react-dom",
        "@types/react"
      ]
    }
  }
}
