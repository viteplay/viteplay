{
  "name": "@viteplay/plugin",
  "version": "0.0.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "case-anything": "^2.1.3",
    "debug": "^4.3.3",
    "fast-glob": "^3.2.7",
    "markdown-it": "^12.3.2",
    "@viteplay/types": "workspace:*"
  },
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "@types/markdown-it": "^12.2.3",
    "eslint": "^8.7.0",
    "eslint-config-viteplay": "workspace:*",
    "vite": "^2.7.13",
    "vitest": "0.2.1",
    "vue": "^3.2.26"
  }
}
