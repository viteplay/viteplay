{
  "name": "@viteplay/plugin",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "/vite-client.js"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup --shims",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/generator": "^7.21.9",
    "@viteplay/types": "workspace:*",
    "case-anything": "^2.1.12",
    "debug": "^4.3.4",
    "fast-glob": "^3.2.12",
    "markdown-it": "^13.0.1"
  },
  "devDependencies": {
    "@babel/types": "^7.21.5",
    "@types/babel__generator": "^7.6.4",
    "@types/debug": "^4.1.8",
    "@types/markdown-it": "^12.2.3",
    "eslint": "^8.41.0",
    "eslint-config-viteplay": "workspace:*",
    "vite": "4.3.8",
    "vitest": "0.31.1",
    "vue": "^3.3.4"
  }
}
