{
  "name": "@viteplay/vue",
  "version": "0.0.1",
  "description": "My awesome typescript library",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "/client.d.ts",
    "/client.js"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./client": "./client.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run vendor-sucrase && vite build",
    "dev": "npm run vendor-sucrase && vite build --watch",
    "test": "vitest run",
    "example": "npm run vendor-sucrase && vite example",
    "vendor-sucrase": "node scripts/vendor-sucrase.mjs",
    "lint": "eslint . --ext .ts,.vue"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/prismjs": "1.16.6",
    "esbuild": "0.14.10",
    "sucrase": "3.20.3",
    "vite": "2.7.13",
    "vue": "3.2.26",
    "vue-prism-editor": "2.0.0-alpha.2",
    "vue-router": "^4.0.12",
    "vite-plugin-dts": "0.9.7",
    "@vitejs/plugin-vue": "2.1.0",
    "eslint": "^8.7.0",
    "eslint-config-viteplay": "workspace:*"
  },
  "dependencies": {
    "prismjs": "^1.25.0"
  },
  "peerDependencies": {
    "vue": "^3.2.26",
    "vue-router": "^4.0.12"
  }
}
