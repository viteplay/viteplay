{
  "name": "@viteplay/vue",
  "version": "0.1.0",
  "description": "My awesome typescript library",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "/client.d.ts",
    "/client.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./client": "./client.js",
    "./iframe": {
      "require": "./dist/iframe/index.js",
      "import": "./dist/iframe/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --project tsconfig.declaration.json",
    "build:lib": "npm run vendor-sucrase && vite build && vite build -c=vite.config.iframe.ts",
    "build": "npm run clean && npm run build:lib && npm run build:types",
    "clean": "rimraf dist",
    "dev": "npm run vendor-sucrase && vite build --watch --mode development",
    "example": "npm run vendor-sucrase && vite example",
    "lint": "eslint . --ext .ts,.vue",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "vendor-sucrase": "node scripts/vendor-sucrase.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@lezer/common": "^0.15.11",
    "@vitejs/plugin-vue": "3.0.3",
    "autoprefixer": "^10.4.2",
    "esbuild": "0.15.5",
    "eslint": "^8.7.0",
    "eslint-config-viteplay": "workspace:*",
    "postcss": "^8.4.16",
    "rimraf": "^3.0.2",
    "sass": "^1.49.9",
    "sucrase": "3.20.3",
    "typescript": "^4.6.4",
    "vite": "3.0.9",
    "vue": "^3.2.37",
    "vue-router": "^4.0.12",
    "vue-tsc": "^0.38.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^0.19.12",
    "@codemirror/basic-setup": "^0.19.1",
    "@codemirror/commands": "^0.19.8",
    "@codemirror/highlight": "^0.19.7",
    "@codemirror/lang-css": "^0.19.3",
    "@codemirror/lang-javascript": "^0.19.7",
    "@codemirror/language": "^0.19.7",
    "@codemirror/state": "^0.19.9",
    "@codemirror/view": "^0.19.43",
    "@lezer/html": "^0.15.1",
    "@pepicons/vue": "^1.0.12",
    "@viteplay/types": "workspace:*",
    "@vueuse/core": "^8.4.0",
    "floating-vue": "2.0.0-beta.16",
    "fuzzysort": "^1.9.0"
  },
  "peerDependencies": {
    "vue": "^3.2.37",
    "vue-router": "^4.0.12"
  }
}
