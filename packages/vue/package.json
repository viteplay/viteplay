{
  "name": "@viteplay/vue",
  "version": "0.0.10",
  "description": "My awesome typescript library",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "/client.d.ts",
    "/client.js"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./client": "./client.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run vendor-sucrase && vite build",
    "dev": "npm run vendor-sucrase && vite build --watch --mode development",
    "test": "vitest run",
    "example": "npm run vendor-sucrase && vite example",
    "vendor-sucrase": "node scripts/vendor-sucrase.mjs",
    "lint": "eslint . --ext .ts,.vue",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@lezer/common": "^0.15.11",
    "@vitejs/plugin-vue": "2.1.0",
    "esbuild": "0.14.10",
    "eslint": "^8.7.0",
    "eslint-config-viteplay": "workspace:*",
    "sucrase": "3.20.3",
    "vite": "2.7.13",
    "vite-plugin-dts": "0.9.7",
    "vue": "3.2.26",
    "vue-router": "^4.0.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^0.19.12",
    "@codemirror/basic-setup": "^0.19.1",
    "@codemirror/commands": "^0.19.8",
    "@codemirror/highlight": "^0.19.7",
    "@codemirror/lang-css": "^0.19.3",
    "@codemirror/lang-javascript": "^0.19.7",
    "@codemirror/language": "^0.19.7",
    "@codemirror/state": "^0.19.9",
    "@codemirror/view": "^0.19.43",
    "@lezer/html": "^0.15.1",
    "@pepicons/vue": "^1.0.12",
    "@viteplay/types": "workspace:*",
    "@vueuse/core": "^7.6.2",
    "naive-ui": "^2.25.2"
  },
  "peerDependencies": {
    "vue": "^3.2.26",
    "vue-router": "^4.0.12"
  }
}
