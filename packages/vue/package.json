{
  "name": "@viteplay/vue",
  "version": "0.2.9",
  "description": "My awesome typescript library",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "/client.d.ts",
    "/client.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./client": "./client.js",
    "./iframe": {
      "require": "./dist/iframe/index.js",
      "import": "./dist/iframe/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --project tsconfig.declaration.json",
    "build:lib": "npm run vendor-sucrase && vite build && vite build -c=vite.config.iframe.ts",
    "build": "npm run clean && npm run build:lib && npm run build:types",
    "clean": "rimraf dist",
    "dev": "npm run vendor-sucrase && vite build --watch --mode development",
    "example": "npm run vendor-sucrase && vite example",
    "lint": "eslint . --ext .ts,.vue",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "vendor-sucrase": "node scripts/vendor-sucrase.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@lezer/common": "^1.0.2",
    "@vitejs/plugin-vue": "4.2.3",
    "autoprefixer": "^10.4.14",
    "esbuild": "0.17.19",
    "eslint": "^8.41.0",
    "eslint-config-viteplay": "workspace:*",
    "postcss": "^8.4.23",
    "rimraf": "^5.0.1",
    "sass": "^1.62.1",
    "sucrase": "3.32.0",
    "typescript": "^5.0.4",
    "vite": "4.3.8",
    "vue": "^3.3.4",
    "vue-router": "^4.2.1",
    "vue-tsc": "^1.6.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.7.1",
    "@codemirror/commands": "^6.2.4",
    "@codemirror/lang-css": "^6.2.0",
    "@codemirror/lang-javascript": "^6.1.8",
    "@codemirror/language": "^6.7.0",
    "@codemirror/state": "^6.2.1",
    "@codemirror/view": "^6.12.0",
    "@lezer/highlight": "^1.1.4",
    "@lezer/html": "^1.3.4",
    "@pepicons/vue": "^3.0.1",
    "@viteplay/types": "workspace:*",
    "@vueuse/core": "^10.1.2",
    "codemirror": "^6.0.1",
    "floating-vue": "2.0.0-beta.20",
    "fuzzysort": "^2.0.4"
  },
  "peerDependencies": {
    "vue": "^3.2.39",
    "vue-router": "^4.0.12"
  }
}
